# =============================================================================
# Mnemonic Master AI — Environment Variables
# Copy to `.env` and fill in. NEVER commit `.env`.
# Every variable is validated at boot by @mnemonic/config (fail-fast).
# =============================================================================

# ----- Runtime -----
NODE_ENV=development

# ----- API (apps/api) -----
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated list of allowed origins for CORS.
API_CORS_ORIGINS=http://localhost:3000
# Public base URL of the API (used by the web app + webhooks).
API_BASE_URL=http://localhost:4000
LOG_LEVEL=debug

# ----- Database (PostgreSQL / Supabase) -----
# Pooled connection (PgBouncer) for the app runtime.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mnemonic?schema=public
# Direct connection for Prisma migrations (no pooler).
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/mnemonic?schema=public

# ----- Redis (rate limiting, caching, queues) -----
REDIS_URL=redis://localhost:6379

# ----- Authentication (Clerk) -----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# ----- AI (OpenAI) -----
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_FALLBACK=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_REQUEST_TIMEOUT_MS=60000

# ----- Storage (Supabase) -----
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxx
SUPABASE_STORAGE_BUCKET=mnemonic-assets

# ----- Payments (Stripe) -----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ----- Email (Resend) -----
RESEND_API_KEY=re_xxx
EMAIL_FROM="Mnemonic Master <no-reply@mnemonicmaster.ai>"

# ----- Push Notifications (Firebase Cloud Messaging) -----
FCM_PROJECT_ID=xxx
FCM_CLIENT_EMAIL=xxx
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
NEXT_PUBLIC_FIREBASE_CONFIG={}

# ----- Web (apps/web) -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
