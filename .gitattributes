# Normalize all text files to LF in the repo and working tree (matches Prettier).
* text=auto eol=lf

# Explicitly binary assets (never normalize).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated lockfile: treat as text but skip diffs.
pnpm-lock.yaml -diff linguist-generated
