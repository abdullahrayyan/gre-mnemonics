// Mnemonic Master AI — PostgreSQL schema (Prisma).
// Organized by domain: Identity & Billing · Catalog · Learning · Gamification
// · Community · Platform · Quiz. Domain enums mirror @mnemonic/core.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum Difficulty {
  BEGINNER
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  PREPOSITION
  CONJUNCTION
  INTERJECTION
  DETERMINER
  PHRASE
  OTHER
}

enum ExamType {
  GRE
  TOEFL
  IELTS
  SAT
  GMAT
  CAT
  UPSC
  SSC
  GENERAL
}

enum Language {
  EN
  HI
  HINGLISH
}

enum WordStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MnemonicType {
  HINGLISH
  ENGLISH
  STORY
  VISUAL
  TRICK
  ROOT
}

enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum WordRelationType {
  SYNONYM
  ANTONYM
  RELATED
  CONFUSABLE
}

enum ContentSource {
  AI
  CURATED
  COMMUNITY
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum SubscriptionPlan {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum LearningStatus {
  NEW
  LEARNING
  REVIEW
  MASTERED
  SUSPENDED
}

enum StudySource {
  FLASHCARD
  QUIZ
  TUTOR
  IMPORT
}

enum DeviceType {
  WEB
  IOS
  ANDROID
  EXTENSION
}

enum XpReason {
  WORD_LEARNED
  REVIEW_COMPLETED
  QUIZ_COMPLETED
  STREAK_BONUS
  DAILY_GOAL
  ACHIEVEMENT
  COMMUNITY
}

enum BadgeTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum AchievementStatus {
  IN_PROGRESS
  EARNED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum ReportTargetType {
  MNEMONIC
  COMMENT
  WORD
  USER
}

enum ReportReason {
  SPAM
  OFFENSIVE
  INCORRECT
  PLAGIARISM
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum NotificationType {
  REVIEW_DUE
  STREAK_REMINDER
  DAILY_GOAL
  ACHIEVEMENT
  COMMUNITY
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum ImageStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum AiGenerationType {
  MNEMONIC_SET
  STORY
  HINGLISH_MNEMONIC
  ENGLISH_MNEMONIC
  MEMORY_TRICK
  VISUAL_PROMPT
  IMAGE_PROMPT
  QUIZ
  EXPLANATION
  TUTOR_CHAT
}

enum AiGenerationStatus {
  SUCCESS
  FAILURE
  PARTIAL
}

enum QuizType {
  WORD_TO_MEANING
  MEANING_TO_WORD
  SYNONYM
  ANTONYM
  SENTENCE_COMPLETION
  FILL_IN_BLANK
  ROOT
  MNEMONIC_RECALL
  TIMED
  MIXED
}

enum QuizStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum QuizQuestionType {
  WORD_TO_MEANING
  MEANING_TO_WORD
  SYNONYM
  ANTONYM
  SENTENCE_COMPLETION
  FILL_IN_BLANK
  ROOT
  MNEMONIC_RECALL
}

// ============================================================================
// Identity & Billing
// ============================================================================

model User {
  id           String     @id @default(cuid())
  clerkId      String     @unique
  email        String     @unique
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  lastActiveAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile            Profile?
  gamification       GamificationProfile?
  subscription       Subscription?
  payments           Payment[]
  learningProgress   LearningProgress[]
  reviewSchedules    Sm2ReviewSchedule[]
  reviews            Review[]
  flashcards         Flashcard[]
  dailyGoals         DailyGoal[]
  studySessions      StudySession[]
  xpEvents           XpEvent[]
  achievements       Achievement[]
  favorites          Favorite[]
  communityMnemonics CommunityMnemonic[]
  votes              Vote[]
  comments           Comment[]
  reportsFiled       Report[]             @relation("ReportReporter")
  reportsResolved    Report[]             @relation("ReportResolver")
  notifications      Notification[]
  aiHistory          AiHistory[]
  quizzes            Quiz[]
  analyticsEvents    AnalyticsEvent[]
  adminLogs          AdminLog[]

  @@index([status])
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String?
  avatarUrl      String?
  nativeLanguage Language @default(HI)
  targetExam     ExamType @default(GRE)
  dailyWordGoal  Int      @default(20)
  timezone       String   @default("UTC")
  bio            String?
  preferences    Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model GamificationProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalXp       Int       @default(0)
  level         Int       @default(1)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastStudyDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([totalXp])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  payments Payment[]

  @@index([status])
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId        String?
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  stripePaymentIntentId String?       @unique
  amountCents           Int
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  description           String?
  createdAt             DateTime      @default(now())

  @@index([userId])
  @@index([status])
}

// ============================================================================
// Catalog (words, exams, categories, AI content)
// ============================================================================

model Exam {
  id          String   @id @default(cuid())
  type        ExamType @unique
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  words      WordExam[]
  categories WordCategory[]
  quizzes    Quiz[]
}

model WordCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  examId      String?
  exam        Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  words WordCategoryOnWord[]

  @@index([examId])
}

model Word {
  id             String       @id @default(cuid())
  word           String
  slug           String       @unique
  pronunciation  String?
  ipa            String?
  difficulty     Difficulty   @default(MEDIUM)
  frequency      Int?
  partOfSpeech   PartOfSpeech @default(OTHER)
  meaning        String
  hindiMeaning   String?
  synonyms       String[]     @default([])
  antonyms       String[]     @default([])
  rootWord       String?
  prefix         String?
  suffix         String?
  etymology      String?
  exampleSentence String?
  commonMistakes String?

  // AI-generated content (canonical, shown to learners)
  aiStory            String?
  hinglishMnemonic   String?
  englishMnemonic    String?
  memoryTrick        String?
  visualMemoryPrompt String?
  imagePrompt        String?

  status    WordStatus @default(DRAFT)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  exams            WordExam[]
  categories       WordCategoryOnWord[]
  relationsFrom    WordRelation[]       @relation("WordRelationSource")
  relationsTo      WordRelation[]       @relation("WordRelationTarget")
  quizQuestions    QuizQuestion[]
  imagePrompts     ImagePrompt[]
  learningProgress LearningProgress[]
  reviewSchedules  Sm2ReviewSchedule[]
  reviews          Review[]
  flashcards       Flashcard[]
  favorites        Favorite[]
  community        CommunityMnemonic[]
  aiHistory        AiHistory[]
  quizAttempts     QuizAttempt[]

  @@unique([word, partOfSpeech])
  @@index([difficulty])
  @@index([status])
  @@index([frequency])
}

model WordExam {
  id              String   @id @default(cuid())
  wordId          String
  word            Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  examId          String
  exam            Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  frequencyRank   Int?
  importance      Int      @default(0)
  isHighFrequency Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([wordId, examId])
  @@index([examId, frequencyRank])
}

model WordCategoryOnWord {
  wordId     String
  word       Word         @relation(fields: [wordId], references: [id], onDelete: Cascade)
  categoryId String
  category   WordCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  assignedAt DateTime     @default(now())

  @@id([wordId, categoryId])
  @@index([categoryId])
}

model WordRelation {
  id        String           @id @default(cuid())
  sourceId  String
  source    Word             @relation("WordRelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId  String
  target    Word             @relation("WordRelationTarget", fields: [targetId], references: [id], onDelete: Cascade)
  type      WordRelationType @default(RELATED)
  createdAt DateTime         @default(now())

  @@unique([sourceId, targetId, type])
  @@index([targetId])
}

model QuizQuestion {
  id            String           @id @default(cuid())
  wordId        String
  word          Word             @relation(fields: [wordId], references: [id], onDelete: Cascade)
  type          QuizQuestionType
  prompt        String
  options       Json             @default("[]")
  correctAnswer String
  explanation   String?
  difficulty    Difficulty       @default(MEDIUM)
  source        ContentSource    @default(AI)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  attempts QuizAttempt[]

  @@index([wordId])
  @@index([type])
}

model ImagePrompt {
  id        String      @id @default(cuid())
  wordId    String
  word      Word        @relation(fields: [wordId], references: [id], onDelete: Cascade)
  prompt    String
  style     String?
  imageUrl  String?
  model     String?
  status    ImageStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([wordId])
  @@index([status])
}

model AiHistory {
  id               String             @id @default(cuid())
  wordId           String?
  word             Word?              @relation(fields: [wordId], references: [id], onDelete: SetNull)
  userId           String?
  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  type             AiGenerationType
  model            String
  prompt           String
  response         Json?
  promptTokens     Int?
  completionTokens Int?
  costCents        Int?
  latencyMs        Int?
  status           AiGenerationStatus @default(SUCCESS)
  error            String?
  createdAt        DateTime           @default(now())

  @@index([wordId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ============================================================================
// Learning (progress, spaced repetition, sessions, goals)
// ============================================================================

model LearningProgress {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId         String
  word           Word           @relation(fields: [wordId], references: [id], onDelete: Cascade)
  status         LearningStatus @default(NEW)
  timesReviewed  Int            @default(0)
  timesCorrect   Int            @default(0)
  timesIncorrect Int            @default(0)
  firstSeenAt    DateTime?
  lastReviewedAt DateTime?
  masteredAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, wordId])
  @@index([userId, status])
}

model Sm2ReviewSchedule {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId         String
  word           Word          @relation(fields: [wordId], references: [id], onDelete: Cascade)
  easeFactor     Float         @default(2.5)
  intervalDays   Int           @default(0)
  repetitions    Int           @default(0)
  lapses         Int           @default(0)
  dueAt          DateTime      @default(now())
  lastReviewedAt DateTime?
  lastRating     ReviewRating?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([userId, wordId])
  @@index([userId, dueAt])
}

model Review {
  id                   String       @id @default(cuid())
  userId               String
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId               String
  word                 Word         @relation(fields: [wordId], references: [id], onDelete: Cascade)
  rating               ReviewRating
  previousIntervalDays Int
  newIntervalDays      Int
  easeFactorAfter      Float
  responseTimeMs       Int?
  source               StudySource  @default(FLASHCARD)
  reviewedAt           DateTime     @default(now())

  @@index([userId, reviewedAt])
  @@index([wordId])
}

model Flashcard {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId      String
  word        Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  deck        String   @default("default")
  note        String?
  isSuspended Boolean  @default(false)
  addedAt     DateTime @default(now())

  @@unique([userId, wordId, deck])
  @@index([userId, deck])
}

model DailyGoal {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime @db.Date
  newWordsTarget    Int      @default(20)
  reviewsTarget     Int      @default(0)
  newWordsCompleted Int      @default(0)
  reviewsCompleted  Int      @default(0)
  xpEarned          Int      @default(0)
  isAchieved        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model StudySession {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt       DateTime    @default(now())
  endedAt         DateTime?
  durationSeconds Int         @default(0)
  wordsStudied    Int         @default(0)
  reviewsCount    Int         @default(0)
  quizzesCount    Int         @default(0)
  xpEarned        Int         @default(0)
  source          StudySource @default(FLASHCARD)
  deviceType      DeviceType  @default(WEB)

  @@index([userId, startedAt])
}

// ============================================================================
// Gamification
// ============================================================================

model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    XpReason
  refType   String?
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Badge {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  description String
  tier        BadgeTier @default(BRONZE)
  icon        String?
  criteria    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  achievements Achievement[]
}

model Achievement {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge             @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  status    AchievementStatus @default(IN_PROGRESS)
  progress  Int               @default(0)
  target    Int               @default(1)
  earnedAt  DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, badgeId])
  @@index([userId, status])
}

// ============================================================================
// Community
// ============================================================================

model CommunityMnemonic {
  id        String           @id @default(cuid())
  wordId    String
  word      Word             @relation(fields: [wordId], references: [id], onDelete: Cascade)
  authorId  String
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  type      MnemonicType     @default(HINGLISH)
  language  Language         @default(HINGLISH)
  upvotes   Int              @default(0)
  downvotes Int              @default(0)
  score     Int              @default(0)
  status    ModerationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  votes    Vote[]
  comments Comment[]

  @@index([wordId, status])
  @@index([score])
}

model Vote {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  mnemonicId String
  mnemonic   CommunityMnemonic @relation(fields: [mnemonicId], references: [id], onDelete: Cascade)
  value      Int
  createdAt  DateTime          @default(now())

  @@unique([userId, mnemonicId])
  @@index([mnemonicId])
}

model Comment {
  id         String            @id @default(cuid())
  mnemonicId String
  mnemonic   CommunityMnemonic @relation(fields: [mnemonicId], references: [id], onDelete: Cascade)
  authorId   String
  author     User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Comment?          @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]         @relation("CommentThread")
  content    String
  status     ModerationStatus  @default(APPROVED)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([mnemonicId])
  @@index([parentId])
}

model Report {
  id           String           @id @default(cuid())
  reporterId   String
  reporter     User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   ReportTargetType
  targetId     String
  reason       ReportReason
  details      String?
  status       ReportStatus     @default(OPEN)
  resolvedById String?
  resolvedBy   User?            @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())

  @@index([status])
  @@index([targetType, targetId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId    String
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, wordId])
  @@index([userId])
}

// ============================================================================
// Platform (notifications, analytics, admin audit)
// ============================================================================

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json                @default("{}")
  channel   NotificationChannel @default(IN_APP)
  status    NotificationStatus  @default(PENDING)
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, status])
  @@index([userId, readAt])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId  String?
  name       String
  properties Json     @default("{}")
  occurredAt DateTime @default(now())

  @@index([name, occurredAt])
  @@index([userId])
}

model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  targetType String?
  targetId   String?
  metadata   Json     @default("{}")
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([action])
}

// ============================================================================
// Quiz
// ============================================================================

model Quiz {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId          String?
  exam            Exam?      @relation(fields: [examId], references: [id], onDelete: SetNull)
  type            QuizType
  status          QuizStatus @default(IN_PROGRESS)
  totalQuestions  Int        @default(0)
  correctCount    Int        @default(0)
  scorePercent    Float      @default(0)
  config          Json       @default("{}")
  startedAt       DateTime   @default(now())
  completedAt     DateTime?
  durationSeconds Int?

  attempts QuizAttempt[]

  @@index([userId, startedAt])
}

model QuizAttempt {
  id             String        @id @default(cuid())
  quizId         String
  quiz           Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  wordId         String
  word           Word          @relation(fields: [wordId], references: [id], onDelete: Cascade)
  questionId     String?
  question       QuizQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  prompt         String
  options        Json          @default("[]")
  userAnswer     String?
  correctAnswer  String
  isCorrect      Boolean       @default(false)
  responseTimeMs Int?
  answeredAt     DateTime      @default(now())

  @@index([quizId])
  @@index([wordId])
}
